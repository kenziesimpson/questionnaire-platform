# Copy to .env and adjust as needed. No secrets belong in images — see
# docs/2-design-doc.md §13. Every value here is an obviously non-secret local
# default; a real deployment supplies all of them from a secret store.

# --- Postgres (db service) ---
# Bootstrap superuser: used only by initdb and the compose `roles` service, never by the app.
POSTGRES_USER=questionnaire
POSTGRES_PASSWORD=questionnaire
POSTGRES_DB=questionnaire_platform
POSTGRES_PORT=5432

# Passwords for the roles db/init/01-roles.sh creates. audit_owner is NOLOGIN and has none.
# Compose interpolates these into connection URLs verbatim, so use only URL-safe characters
# (A-Z a-z 0-9 . _ ~ -); the roles script refuses anything else rather than let a URL break later.
# The compose `roles` service applies db/init/01-roles.sh on every `up`, so a changed password
# or a newly added role takes effect on the next `docker compose up` without a volume reset.
QP_OWNER_PASSWORD=qp_owner
QP_DEFINITION_PASSWORD=qp_definition
QP_EXECUTION_PASSWORD=qp_execution
QP_REPORTING_PASSWORD=qp_reporting

# --- Backend ---
BACKEND_PORT=3000
LOG_LEVEL=info
# Three connection strings, one per role; there is deliberately no unsuffixed DATABASE_URL.
# Compose builds its own from the values above with host `db`; these are for running on the host.
# migrate service (migrations, partitions)
DATABASE_URL_OWNER=postgres://qp_owner:qp_owner@localhost:5432/questionnaire_platform
# backend authoring pool, and the seed
DATABASE_URL_DEFINITION=postgres://qp_definition:qp_definition@localhost:5432/questionnaire_platform
# backend execution pool
DATABASE_URL_EXECUTION=postgres://qp_execution:qp_execution@localhost:5432/questionnaire_platform
# backend reporting pool — session/response only, read-only (gh#18)
DATABASE_URL_REPORTING=postgres://qp_reporting:qp_reporting@localhost:5432/questionnaire_platform

# --- Tests ---
# Optional. Skips Testcontainers and uses an existing instance whose roles already exist.
# An admin URL (the bootstrap superuser): it creates the test databases, while migrations
# still run as qp_owner using QP_OWNER_PASSWORD, and the grant tests use the other two passwords.
# TEST_DATABASE_URL=postgres://questionnaire:questionnaire@localhost:5432/postgres

# --- Frontend ---
FRONTEND_PORT=8080
