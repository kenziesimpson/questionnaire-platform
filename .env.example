# Copy to .env and adjust as needed. No secrets belong in images — see
# docs/2-design-doc.md §13.

# --- Postgres (db service) ---
POSTGRES_USER=questionnaire
POSTGRES_PASSWORD=questionnaire
POSTGRES_DB=questionnaire_platform
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
LOG_LEVEL=info
# Built from the Postgres vars above; override directly if you point at a
# different database (e.g. running the backend outside Docker).
DATABASE_URL=postgres://questionnaire:questionnaire@localhost:5432/questionnaire_platform

# --- Frontend ---
FRONTEND_PORT=8080
