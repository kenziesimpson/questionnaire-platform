    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Backend log lines at warn and error, from the container logs the Collector reads. nginx lines carry no level, so they never appear here: see the next panel. Open a line's trace_id to reach its trace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"qp-.+\"} | detected_level=~\"warn|error\"",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
