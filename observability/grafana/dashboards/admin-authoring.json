    {
      "type": "timeseries",
      "title": "Authoring and reporting errors by route",
      "description": "4xx are expected problem responses (a conflict, a validation refusal); watch the 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
