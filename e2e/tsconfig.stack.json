{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": ["stack"]
}
